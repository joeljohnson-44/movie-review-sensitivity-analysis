        "import torch\n",
        "from sklearn.metrics import accuracy_score, classification_report, confusion_matrix, f1_score\n",
        "from tqdm import tqdm\n",
        "import numpy as np\n",
        "\n",
        "torch.cuda.empty_cache()\n",
        "MODEL_PATH = os.path.join(\"models\",\"distilbert_model\")\n",
        "model = model_utils.TransformerSentimentModel()\n",
        "# Use the class's own load method\n",
        "model.load(MODEL_PATH)\n",
        "\n",
        "def batch_predict(model,X_test,y_test):\n",
        "  batch_size = 32\n",
        "  y_pred = []\n",
        "  with torch.no_grad():\n",
        "      # Make sure batch_size is an integer\n",
        "      for start_idx in tqdm(range(0, len(X_test), batch_size)):\n",
        "          end_idx = min(start_idx + batch_size, len(X_test))  # ensures last batch doesn't go out of bounds\n",
        "          batch_X = X_test[start_idx:end_idx]                # slice exactly the samples for this batch\n",
        "          preds = model.predict(batch_X)                     # predict on this batch\n",
        "          y_pred.extend(preds)                               # add to the list\n",
        "\n",
        "      # Convert to NumPy array for metrics\n",
        "      y_pred = np.array(y_pred)\n",
        "\n",
        "      print(f\"Total predictions: {len(y_pred)}; Total true labels: {len(y_test)}\")\n",
        "  results = {\n",
        "            \"accuracy\": accuracy_score(y_test, y_pred),\n",
        "            \"f1_score\": f1_score(y_test, y_pred),\n",
        "            \"classification_report\": classification_report(y_test, y_pred),\n",
        "            \"confusion_matrix\": confusion_matrix(y_test, y_pred)\n",
        "        }\n",
        "  print(\"Accuracy:\", results[\"accuracy\"])\n",
        "  print(\"F1-Score:\", results[\"f1_score\"])\n",
        "  print(\"\\nClassification Report:\\n\")\n",
        "  print(results[\"classification_report\"])\n",
        "  print(\"\\nConfusion Matrix:\\n\")\n",
        "  print(results[\"confusion_matrix\"])\n",
        "\n",
        "batch_predict(model,X_test,y_test)\n"
      ],
