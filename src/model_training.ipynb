      ],
      "source": [
        "if not os.path.exists(\"models\"):\n",
        "    os.mkdir(\"models\")\n",
        "\n",
        "def evaluate_model(model, name):\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(f\"Training and Evaluating: {name}\")\n",
        "    print(\"=\"*60)\n",
        "\n",
        "    model.train(X_train, y_train)\n",
        "    model.print_evaluation(X_test, y_test)\n",
        "\n",
        "# 1. VADER (NLTK)\n",
        "vader_model = model_utils.NLTKSentimentModel()\n",
        "evaluate_model(vader_model, \"NLTK VADER Sentiment Model\")\n",
        "\n",
        "\n",
        "# 2. TFIDF + Logistic Regression\n",
        "lr_model = model_utils.TfidfLogisticSentimentModel()\n",
        "evaluate_model(lr_model, \"TFIDF Logistic Regression Model\")\n",
        "lr_model.save(os.path.join(\"models\",\"logistic_model.pkl\"))\n",
        "\n",
        "# 3. TFIDF + Random Forest\n",
        "rf_model = model_utils.TfidfRandomForestSentimentModel()\n",
        "evaluate_model(rf_model, \"TFIDF Random Forest Model\")\n",
        "rf_model.save(os.path.join(\"models\",\"random_forest_model.pkl\"))\n",
        "\n",
        "# 4. TFIDF + XGBoost\n",
        "xgb_model = model_utils.TfidfXGBoostSentimentModel()\n",
        "evaluate_model(xgb_model, \"TFIDF XGBoost Model\")\n",
        "xgb_model.save(os.path.join(\"models\",\"xgboost_model.pkl\"))"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# 5. Transformer Model (DistilBERT)\n",
        "transformer_model = model_utils.TransformerSentimentModel()\n",
        "transformer_model.train(X_train, y_train)\n",
        "transformer_model.save(os.path.join(\"models\",\"distilbert_model\"))\n",
        "\n",
        "print(\"\\nAll models trained and saved successfully!\")"
      ],
